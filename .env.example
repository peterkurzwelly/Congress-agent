# Database
DATABASE_URL=sqlite+aiosqlite:///./data/congress_trades.db

# Anthropic API (for PDF vision parsing)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Congress.gov API (free, get key at https://api.congress.gov/sign-up/)
CONGRESS_API_KEY=

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email Alerts (SMTP)
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Scheduler
ENABLE_SCHEDULER=false
SCRAPE_INTERVAL_HOURS=6
SENATE_SCRAPE_INTERVAL_HOURS=4
REQUEST_DELAY_SECONDS=1.0

# Thresholds
ANOMALY_ALERT_THRESHOLD=50
LARGE_TRADE_THRESHOLD=100000
STOCK_ACT_DISCLOSURE_DAYS=45
